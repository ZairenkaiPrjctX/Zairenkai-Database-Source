{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZairenkaiPrjctX/Zairenkai-Database-Source/schemas/source-registry.schema.json",
  "title": "AFID metadata pipeline source registry (registry/sources.json)",
  "description": "Firmware metadata sources the CodeBuild pipeline may query. A provider is used only when enabled, and it may be enabled only after an approved review (checked by tools/validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "updated", "providers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_version": {"type": "integer", "minimum": 1},
    "updated": {"type": "string", "format": "date"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/provider"}
    }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$"
    },
    "https_url": {"type": "string", "pattern": "^https://[^\\s/?#@]+(/[^\\s]*)?$", "maxLength": 2048},
    "nullable_text": {"type": ["string", "null"], "maxLength": 2000},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "provider_type", "afid_provider", "enabled", "base_url",
        "allowed_hosts", "discovery", "supported_fields", "limits", "rate_limit_policy",
        "robots", "review", "attribution", "license_notes", "capabilities",
        "last_successful_discovery", "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "provider_type": {"enum": ["community_firmware_dump", "tool", "synthetic_fixture"]},
        "afid_provider": {
          "description": "Matching entry in config/provider_registry.yml; hosts and endpoints must agree with it.",
          "type": ["string", "null"]
        },
        "enabled": {"type": "boolean"},
        "base_url": {"$ref": "#/$defs/https_url"},
        "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hostname"}},
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy"],
          "properties": {
            "strategy": {"enum": ["gitlab_group_branches", "synthetic_fixture", "none"]},
            "api_base": {"$ref": "#/$defs/https_url"},
            "group": {"type": "integer", "minimum": 1},
            "group_path": {"type": "string", "minLength": 1}
          },
          "if": {"properties": {"strategy": {"const": "gitlab_group_branches"}}},
          "then": {"required": ["api_base", "group", "group_path"]}
        },
        "supported_fields": {
          "description": "Record fields this source can fill, and whether the value comes from the source or is inferred.",
          "type": "object",
          "additionalProperties": {"enum": ["source", "inferred"]},
          "propertyNames": {
            "enum": [
              "manufacturer", "device_name", "device_codename", "soc", "android_version",
              "build_id", "firmware_version", "region", "release_date", "file_name",
              "file_size_bytes", "sha256", "download_url"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_timeout_seconds", "min_interval_seconds", "max_retries", "backoff_seconds",
            "max_pages", "max_records", "max_requests", "max_response_bytes", "max_run_seconds"
          ],
          "properties": {
            "request_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 120},
            "min_interval_seconds": {"type": "number", "minimum": 0.2, "maximum": 60},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
            "backoff_seconds": {"type": "number", "minimum": 0.5, "maximum": 60},
            "max_pages": {"type": "integer", "minimum": 1, "maximum": 50},
            "max_records": {"type": "integer", "minimum": 1, "maximum": 5000},
            "max_requests": {"type": "integer", "minimum": 1, "maximum": 1000},
            "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608},
            "max_run_seconds": {"type": "integer", "minimum": 10, "maximum": 3000}
          }
        },
        "rate_limit_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["published", "evidence_url", "checked_on", "notes"],
          "properties": {
            "published": {"$ref": "#/$defs/nullable_text"},
            "evidence_url": {"type": ["string", "null"]},
            "checked_on": {"type": ["string", "null"], "format": "date"},
            "notes": {"type": "string"}
          }
        },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "checked_on", "finding"],
          "properties": {
            "url": {"type": ["string", "null"]},
            "checked_on": {"type": ["string", "null"], "format": "date"},
            "finding": {"type": "string"}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status", "access_mechanism", "legal_terms", "endpoint_stability",
            "resource_consumption", "reviewed_by", "reviewed_on"
          ],
          "properties": {
            "status": {"enum": ["pending", "approved", "rejected"]},
            "access_mechanism": {"type": "string"},
            "legal_terms": {"type": "string"},
            "endpoint_stability": {"type": "string"},
            "resource_consumption": {"type": "string"},
            "reviewed_by": {"type": ["string", "null"]},
            "reviewed_on": {"type": ["string", "null"], "format": "date"}
          }
        },
        "attribution": {"type": "string"},
        "license_notes": {"type": "string"},
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed", "assumed"],
          "properties": {
            "confirmed": {"type": "array", "items": {"type": "string"}},
            "assumed": {"type": "array", "items": {"type": "string"}}
          }
        },
        "last_successful_discovery": {
          "description": "Changed only by a reviewed pull request; runs report their own time in the manifest.",
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "limitations": {"type": "string"}
      }
    }
  }
}
